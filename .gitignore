# ---- 构建产物 ----
# Wails 编译输出（build/windows 下的 icon、manifest 等打包配置需要保留）
build/bin/
build/darwin/
build/linux/

# 前端构建产物
frontend/dist/
frontend/package.json.md5
.wails/
# vite 依赖预构建缓存（默认在 node_modules/.vite，指定 dir 时可能落到这里）
frontend/.vite/
.vite/

# 可执行文件
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# ---- 数据库（重要）----
# app.go 的 dbFile() 在 UserConfigDir() 失败时会退回相对路径 "muster.db"，
# 此时库文件会落在仓库根目录，必须忽略，否则会被 git add . 提交
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- 依赖 ----
node_modules/
frontend/node_modules/
vendor/

# ---- 日志与临时文件 ----
*.log
*.tmp
tmp/
.DS_Store
Thumbs.db

# ---- 编辑器 / IDE ----
.idea/
.vscode/
.vs/
*.suo
*.user
*.swp
*~

# ---- AI 工具本地数据 ----
# WorkBuddy 工作区记忆与本地状态，只属于本机，不入库
.workbuddy/
.claude/
.cursor/
.trae/

# ---- 环境与本地配置 ----
.env
.env.local
*.local
